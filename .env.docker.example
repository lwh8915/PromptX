# Docker 部署环境变量配置
# 复制此文件为 .env 并填入实际值

# MongoDB 配置（必须）
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=PromptX

# SMTP 邮件配置（可选，用于密码重置功能）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_authorization_code
SMTP_FROM_NAME=Prompt Manager

# LLM API 配置 (用于 AI 提示词修改功能)
# LLM API 配置 (用于 AI 提示词修改功能)
# 示例配置 (请填入实际值)
LLM_BASE_URL=https://your-llm-api.com/v1/chat/completions
LLM_API_KEY=your_api_key_here
LLM_MODEL=your_model_name

# ============ 应用配置 ============
# 应用版本号（可选，用于自定义展示的版本号）
APP_VERSION=1.0.0



